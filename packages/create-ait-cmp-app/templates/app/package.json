{
  "name": "ait-cmp-template",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/web.mjs dev",
    "dev:toss": "node scripts/web.mjs dev:toss",
    "build": "node scripts/web.mjs build",
    "dev:web": "node scripts/web.mjs dev:web",
    "build:web": "node scripts/web.mjs build:web",
    "lint": "yarn lint:js && yarn lint:kotlin",
    "lint:js": "eslint . --max-warnings=0",
    "lint:kotlin": "node scripts/lint-kotlin.mjs",
    "lint:fix": "yarn lint:js --fix && yarn lint:kotlin --fix"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "3.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
