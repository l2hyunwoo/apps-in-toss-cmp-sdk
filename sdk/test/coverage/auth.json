{
  "TossAuth.isIntegrated": {
    "bridge": "isIntegrated",
    "capability": "TOSS_LOGIN_INTEGRATION"
  },
  "TossAuth.login": {
    "bridge": "login",
    "capability": "TOSS_LOGIN"
  },
  "TossAuth.sign": {
    "bridge": "sign",
    "capability": "TOSS_SIGN"
  },
  "appLogin": {
    "replaced": "TossAuth.login"
  },
  "appsInTossSignTossCert": {
    "replaced": "TossAuth.sign"
  },
  "getIsTossLoginIntegratedService": {
    "replaced": "TossAuth.isIntegrated"
  }
}
